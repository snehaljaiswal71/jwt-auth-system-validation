{
  "info": {
    "name": "JWT Auth System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "username", "value": "john_doe01" },
    { "key": "email", "value": "john_doe@example.com" },
    { "key": "password", "value": "Secret@123" },
    { "key": "userType", "value": "Administrator" },
    { "key": "otp", "value": "" },
    { "key": "token", "value": "" },
    { "key": "productId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign up",
          "event": [{ "listen": "test", "script": { "exec": [
            "const body = pm.response.json();",
            "if (body.otp) { pm.collectionVariables.set('otp', body.otp); }",
            "pm.test('201 Created', () => pm.response.to.have.status(201));"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/signup",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"userType\": \"{{userType}}\"\n}" }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/verify-otp",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"otp\": \"{{otp}}\"\n}" }
          }
        },
        {
          "name": "Resend OTP",
          "event": [{ "listen": "test", "script": { "exec": [
            "const body = pm.response.json();",
            "if (body.otp) { pm.collectionVariables.set('otp', body.otp); }"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/resend-otp",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\"\n}" }
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().accessToken); }"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}" }
          }
        },
        {
          "name": "Login (invalid, redirects to Login Failed)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"Wrong@1234\"\n}" }
          }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/logout" }
        }
      ]
    },
    {
      "name": "Dashboard & Settings",
      "item": [
        { "name": "Dashboard", "request": { "method": "GET", "url": "{{baseUrl}}/api/dashboard" } },
        { "name": "Settings (Administrator only)", "request": { "method": "GET", "url": "{{baseUrl}}/api/settings" } }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create product",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) { pm.collectionVariables.set('productId', pm.response.json().id); }"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/products",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Wireless Mouse\",\n  \"description\": \"Ergonomic 2.4 GHz wireless mouse\",\n  \"price\": 799.99,\n  \"quantity\": 25,\n  \"category\": \"Electronics\"\n}" }
          }
        },
        {
          "name": "List products (filter, sort, page)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?name=mouse&category=Electronics&minPrice=100&maxPrice=1000&page=0&size=10&sort=price,desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "name", "value": "mouse" },
                { "key": "category", "value": "Electronics" },
                { "key": "minPrice", "value": "100" },
                { "key": "maxPrice", "value": "1000" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sort", "value": "price,desc" }
              ]
            }
          }
        },
        { "name": "Get product", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/{{productId}}" } },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/products/{{productId}}",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Wireless Mouse Pro\",\n  \"description\": \"Silent clicks\",\n  \"price\": 999.00,\n  \"quantity\": 10,\n  \"category\": \"Electronics\"\n}" }
          }
        },
        { "name": "Delete product", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/products/{{productId}}" } }
      ]
    }
  ]
}
